+    def test_no_alias_audit_row_is_lost(self, tmp_path):
+        dm = self._old_audit(tmp_path)
+        with sqlite3.connect(dm.db_path) as conn:
+            assert conn.execute(
+                "SELECT COUNT(*) FROM listing_claim_aliases_quarantine"
+            ).fetchone()[0] == 1
+        dm.close()
