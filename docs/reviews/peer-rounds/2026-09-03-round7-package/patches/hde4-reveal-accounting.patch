+def _rows(db, **where):
+    sql = "SELECT * FROM hdencode_reveal_observations"
+    params = ()
+    if where:
+        sql += " WHERE " + " AND ".join(f"{k} = ?" for k in where)
+        params = tuple(where.values())
+    sql += " ORDER BY id ASC"
+    return db._query_dicts(sql, params, default=[])
