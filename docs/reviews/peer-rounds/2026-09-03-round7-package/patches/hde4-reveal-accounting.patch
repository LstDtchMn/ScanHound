+        "(source, outcome, caller, context_id, url_hash, diagnostic_code, recorded_at) "
+        "VALUES (?, ?, ?, ?, ?, ?, ?)",
+        (source, outcome, caller, context_id, url_hash, diagnostic_code, recorded_at),
+        label="test_seed_row",
+    )
