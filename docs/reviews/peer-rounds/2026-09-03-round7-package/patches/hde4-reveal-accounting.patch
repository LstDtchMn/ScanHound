+class _NoOpCoordinator:
+    """A coordinator that never throttles, denies, or cancels."""
+
+    def prioritize(self, priority):
+        class _Ctx:
+            def __enter__(self_inner):
+                return None
+
+            def __exit__(self_inner, *exc):
+                return False
+
+        return _Ctx()
