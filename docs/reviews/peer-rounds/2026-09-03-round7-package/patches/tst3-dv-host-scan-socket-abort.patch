+def _consume_body(handler):
+    """Read and discard the request body before a toy handler responds.
+
+    A handler that answers without reading ``Content-Length`` bytes never
+    waits for the request body. The client sends its headers and its body as
+    two socket writes, so under load the body can reach this server after the
+    handler has replied and socketserver has closed the connection; the late
+    segment draws a reset, and on Windows the client's read of the response
+    then fails with ``[WinError 10053] An established connection was aborted
+    by the software in your host machine``. Reading the body first means the
+    close always follows the complete request. Tolerates a missing or zero
+    Content-Length (the shared GET/POST handler).
+    """
+    try:
+        length = int(handler.headers.get("Content-Length", 0) or 0)
+    except (TypeError, ValueError):
+        length = 0
+    if length:
+        handler.rfile.read(length)
+
