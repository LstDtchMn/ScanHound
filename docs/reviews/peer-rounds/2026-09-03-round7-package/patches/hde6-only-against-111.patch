+    assert snapshot["block_streak"] == 0
 
 
 def test_same_application_context_retains_shared_block_streak():
@@ -229,3 +297,94 @@ def test_expired_legacy_block_allows_one_probe():
     }
     with coordinator.request("listing"):
         pass
