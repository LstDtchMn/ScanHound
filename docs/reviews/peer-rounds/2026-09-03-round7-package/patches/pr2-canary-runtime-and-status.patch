+    candidate.pop(PROMOTION_KEY, None)
+    candidate[LAST_DEMOTION_KEY] = demotion
+    must_contain = {"hdencode_discovery_mode": "rss_shadow",
+                    LAST_DEMOTION_KEY: demotion}
