+
+    OMISSIONS = [
+        ("source missing", {"listing_category": "tv", "listing_type": "tv"}),
+        ("category missing", {"source": "hdencode", "listing_type": "tv"}),
+        ("source blank", {"source": "   ", "listing_category": "tv",
